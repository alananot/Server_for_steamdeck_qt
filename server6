from flask import Flask, Response, jsonify
import cv2
import numpy as np
from picamera2 import Picamera2
import RPi.GPIO as GPIO
import serial
import threading
import time

GPIO.setmode(GPIO.BOARD)
GPIO.setup(11, GPIO.OUT, initial=GPIO.LOW)

app = Flask(__name__)

# --- TARGET RESOLUTION CONFIG ---
FRAME_W = 1280  # Scale up resolution here
FRAME_H = 720
PROC_W = 320  # Fixed downscaled size for lightning-fast CV processing
PROC_H = 240
SCALE_X = FRAME_W / PROC_W
SCALE_Y = FRAME_H / PROC_H

picam2 = Picamera2()
config = picam2.create_video_configuration(
    main={"size": (FRAME_W, FRAME_H), "format": "BGR888"},
    controls={"FrameRate": 60},
)
picam2.configure(config)
picam2.start()
picam2.set_controls({"ExposureTime": 800, "AnalogueGain": 6.0})

# Thresholds & State
BRIGHTNESS_THRESHOLD = 200
LOCK_THRESHOLD = 5
LOCK_LOST_THRESHOLD = 60
MAX_JUMP = 200 / SCALE_X

tracked_cx, tracked_cy = None, None
lock_counter, lost_counter = 0, 0
is_locked, force_unlock = False, False
unlock_cooldown_until = 0
velocity_x, velocity_y = 0.0, 0.0
predicted_cx, predicted_cy = None, None
smooth_cx, smooth_cy = 0, 0

frame_count = 0
fps_start = time.time()
current_fps = 0.0

latest_jpeg = None
jpeg_lock = threading.Lock()

ser = serial.Serial("/dev/serial0", baudrate=115200, timeout=0.0001)


def fire_gpio_async():
  GPIO.output(11, GPIO.HIGH)
  time.sleep(1)
  GPIO.output(11, GPIO.LOW)


def camera_loop():
  global tracked_cx, tracked_cy, lock_counter, lost_counter, is_locked
  global smooth_cx, smooth_cy, force_unlock, unlock_cooldown_until
  global velocity_x, velocity_y, predicted_cx, predicted_cy
  global frame_count, fps_start, current_fps, latest_jpeg

  while True:
    # FPS Counter
    frame_count += 1
    elapsed = time.time() - fps_start
    if elapsed >= 1.0:
      current_fps = frame_count / elapsed
      frame_count = 0
      fps_start = time.time()

    # Capture direct BGR frame
    frame = picam2.capture_array()

    # Create downscaled grayscale image ONLY for processing
    small_frame = cv2.resize(
        frame, (PROC_W, PROC_H), interpolation=cv2.INTER_NEAREST
    )
    gray = cv2.cvtColor(small_frame, cv2.COLOR_BGR2GRAY)
    _, mask = cv2.threshold(
        gray, BRIGHTNESS_THRESHOLD, 255, cv2.THRESH_BINARY
    )

    contours, _ = cv2.findContours(
        mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
    )

    # Tracker Logic (Running at 320x240 scale)
    if force_unlock:
      tracked_cx, tracked_cy = None, None
      lock_counter, lost_counter = 0, 0
      is_locked = False
      force_unlock = False
      velocity_x, velocity_y = 0.0, 0.0
      predicted_cx, predicted_cy = None, None
      unlock_cooldown_until = time.time() + 10

    if time.time() >= unlock_cooldown_until and len(contours) > 0:
      if tracked_cx is None:
        best_c = max(contours, key=cv2.contourArea)
        M = cv2.moments(best_c)
        if M["m00"] > 0:
          tracked_cx = int(M["m10"] / M["m00"])
          tracked_cy = int(M["m01"] / M["m00"])
          lock_counter, lost_counter = 1, 0
      else:
        # Distance checks in low-res coordinates
        search_cx = (
            predicted_cx if predicted_cx is not None else tracked_cx
        )
        search_cy = (
            predicted_cy if predicted_cy is not None else tracked_cy
        )

        best_dist = float("inf")
        new_cx, new_cy = 0, 0
        for c in contours:
          M = cv2.moments(c)
          if M["m00"] > 0:
            ccx = int(M["m10"] / M["m00"])
            ccy = int(M["m01"] / M["m00"])
            dist = ((ccx - search_cx) ** 2 + (ccy - search_cy) ** 2) ** 0.5
            if dist < best_dist:
              best_dist, new_cx, new_cy = dist, ccx, ccy

        if best_dist < MAX_JUMP:
          velocity_x = velocity_x * 0.7 + (new_cx - tracked_cx) * 0.3
          velocity_y = velocity_y * 0.7 + (new_cy - tracked_cy) * 0.3
          tracked_cx, tracked_cy = new_cx, new_cy
          lock_counter = min(lock_counter + 1, LOCK_THRESHOLD + 1)
          lost_counter = 0
          predicted_cx, predicted_cy = None, None
        else:
          lost_counter += 1
          predicted_cx = int(tracked_cx + velocity_x)
          predicted_cy = int(tracked_cy + velocity_y)

    if lost_counter >= LOCK_LOST_THRESHOLD:
      tracked_cx, tracked_cy = None, None
      lock_counter, lost_counter = 0, 0
      is_locked = False

    is_locked = lock_counter >= LOCK_THRESHOLD

    # Scale target coordinates up to High-Res frame for overlays & output
    if tracked_cx is not None and lock_counter > 0:
      smooth_cx = int(tracked_cx * SCALE_X)
      smooth_cy = int(tracked_cy * SCALE_Y)

      # Non-blocking Serial Write
      data_coord = f"{smooth_cx},{smooth_cy}\n"
      ser.write(data_coord.encode("utf-8"))

      if ser.in_waiting > 0:
        message = ser.readline().decode().strip()
        if message == "Shoot":
          threading.Thread(target=fire_gpio_async, daemon=True).start()

      # Draw Box on High-Res Frame
      size = int(20 * SCALE_X)
      cv2.rectangle(
          frame,
          (smooth_cx - size, smooth_cy - size),
          (smooth_cx + size, smooth_cy + size),
          (0, 255, 0),
          2,
      )

    # Draw FPS on high-res frame
    cv2.putText(
        frame,
        f"FPS: {int(current_fps)}",
        (10, 30),
        cv2.FONT_HERSHEY_SIMPLEX,
        1.0,
        (140, 140, 140),
        2,
    )

    # Encode JPEG with lower quality for high speed stream
    _, jpeg = cv2.imencode(
        ".jpg", frame, [int(cv2.IMWRITE_JPEG_QUALITY), 50]
    )

    with jpeg_lock:
      latest_jpeg = jpeg.tobytes()


cam_thread = threading.Thread(target=camera_loop, daemon=True)
cam_thread.start()


def generate():
  while True:
    with jpeg_lock:
      if latest_jpeg is None:
        time.sleep(0.005)
        continue
      frame_bytes = latest_jpeg
    yield (
        b"--frame\r\n"
        b"Content-Type: image/jpeg\r\n\r\n" + frame_bytes + b"\r\n"
    )


@app.route("/video")
def video():
  return Response(
      generate(), mimetype="multipart/x-mixed-replace; boundary=frame"
  )


@app.route("/status")
def status():
  return jsonify({
      "locked": is_locked,
      "cx": smooth_cx,
      "cy": smooth_cy,
      "fps": int(current_fps),
  })


if __name__ == "__main__":
  app.run(host="0.0.0.0", port=8080, threaded=True)
